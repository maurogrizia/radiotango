{
  "hosting": {
    "public": "build",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "/sitemap",
        "run": { "serviceId": "radiotango-api-prod", "region": "southamerica-east1" }
      },
      {
        "source": "/sitemap.xml",
        "run": { "serviceId": "radiotango-api-prod", "region": "southamerica-east1" }
      },
      {
        "source": "/api/**",
        "run": { "serviceId": "radiotango-api-prod", "region": "southamerica-east1" }
      },
      {
        "source": "/ES/**",
        "run": { "serviceId": "radiotango-api-prod", "region": "southamerica-east1" }
      },
      {
        "source": "/EN/**",
        "run": { "serviceId": "radiotango-api-prod", "region": "southamerica-east1" }
      },
      {
        "source": "**",
        "destination": "/index.html"
      }
    ],
    "headers": [
      {
        "source": "/static/**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=31536000, immutable"
          }
        ]
      }
    ]
  }
}
