{
  "hosting": {
    "public": "build",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "/sitemap",
        "run": { "serviceId": "radiotango-api-prod", "region": "southamerica-east1" }
      },
      {
        "source": "/sitemap.xml",
        "run": { "serviceId": "radiotango-api-prod", "region": "southamerica-east1" }
      },
      {
        "source": "/api/**",
        "run": { "serviceId": "radiotango-api-prod", "region": "southamerica-east1" }
      },
      {
        "source": "/ES/artists/**",
        "run": { "serviceId": "radiotango-api-prod", "region": "southamerica-east1" }
      },
      {
        "source": "/EN/artists/**",
        "run": { "serviceId": "radiotango-api-prod", "region": "southamerica-east1" }
      },
      {
        "source": "/ES/playlists/**",
        "run": { "serviceId": "radiotango-api-prod", "region": "southamerica-east1" }
      },
      {
        "source": "/EN/playlists/**",
        "run": { "serviceId": "radiotango-api-prod", "region": "southamerica-east1" }
      },
      {
        "source": "/ES/posts/**",
        "run": { "serviceId": "radiotango-api-prod", "region": "southamerica-east1" }
      },
      {
        "source": "/EN/posts/**",
        "run": { "serviceId": "radiotango-api-prod", "region": "southamerica-east1" }
      },
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  },
  "functions": [
    {
      "runtime": "nodejs18",
      "source": "../backend",
      "codebase": "default",
      "ignore": [
        "node_modules",
        ".git",
        "firebase-debug.log",
        "firebase-debug.*.log"
      ]
    }
  ]
}
